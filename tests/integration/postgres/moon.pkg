import {
  "moonbit-community/sqlmap/core",
  "moonbit-community/sqlmap/parse",
  "moonbit-community/sqlmap/controller",
  "moonbit-community/sqlmap/request",
  "moonbit-community/sqlmap/report",
  "moonbit-community/postgres/client" @pg,
  "moonbitlang/async" @pgasync,
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
} for "wbtest"

supported_targets = "native+wasm"

options(
  "allow-experimental-packages": true,
)
